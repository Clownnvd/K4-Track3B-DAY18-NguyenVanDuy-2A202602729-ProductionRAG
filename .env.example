# Copy to .env and supply a Gemini key locally. Never commit .env.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
EVAL_MODEL=gemini-3.5-flash-lite
# Explicit opt-in after authorization; unit tests do not make paid calls.
ENABLE_LLM_EVAL=0
ENABLE_LLM_ENRICHMENT=0
TORCH_NUM_THREADS=2
GEMINI_MIN_INTERVAL_SECONDS=4.2
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
